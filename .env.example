# Copy to .env.local for local dev. Netlify's own env vars (not this file)
# are what the deployed site actually reads — set these in the Netlify UI:
# Project → Configuration → Environment variables.

# Powers the AI lesson helper (netlify/functions/lesson-chat.ts), currently
# shown at the bottom of lessons in the Microsoft Data & BI Developer path,
# and the Professional Mock Interview's conversational engine
# (netlify/functions/mock-interview-turn.ts).
ANTHROPIC_API_KEY=

# Professional Mock Interview database (prisma/schema.prisma). Local dev
# uses a SQLite file ("file:./dev.db"); production needs a real Postgres
# connection string (Netlify DB / Neon) set in Netlify's own env vars.
DATABASE_URL=

# Phase C — absolute site URL used only to build the Professional Mock
# Interview certificate's QR code and the printed verification link (a QR
# code needs a real absolute URL; a relative path means nothing once it's
# printed on paper or scanned away from the site). Falls back to the
# Netlify URL from CLAUDE.md if unset.
MOCK_INTERVIEW_SITE_URL=

# Phase D follow-up — REPLACES the old shared-secret admin gate. Secures
# the signed admin SESSION token issued by /api/admin-login after a real
# email+password check (lib/adminAuth.ts). A deliberately different secret
# from WIX_MEMBER_TOKEN_SECRET below — an admin session and a student
# identity must never be forgeable with the same key. Generate with
# `openssl rand -hex 32`. The admin account itself is created locally with
# `node scripts/create-admin.js <email> <password>`, never via an HTTP endpoint.
ADMIN_SESSION_SECRET=

# Phase C — provisional per-category passing minimum (spec requirement 2),
# as a percentage 0-100. Defaults to 60 if unset; see
# lib/interviewScoring.ts's getConfiguredMinimumSkillAreaScore().
MOCK_INTERVIEW_MIN_SKILL_SCORE=

# Phase D — secures the signed Wix member-IDENTITY token (memberId + email,
# lib/wixMemberToken.ts), minted by a NEW Velo backend snippet (see the
# Phase D report for the exact code) and verified here. A DIFFERENT secret
# from LESSON_GATE_SECRET on purpose — that one only proves "logged in",
# this one carries a real identity, and the two should never be
# interchangeable. Generate a long random value (e.g. `openssl rand -hex 32`)
# and put the SAME value in both this env var and the Velo backend code's
# own secret constant.
WIX_MEMBER_TOKEN_SECRET=

# Phase D — the PUBLIC half of the RSA key pair Wix signs its Pricing Plans
# "Order Purchased" webhook with (netlify/functions/wix-interview-purchase-webhook.ts).
# Retrieve it from Wix Dev Center → your app → Webhooks → "Get Public Key"
# (PEM format). If pasting into a UI that can't hold real newlines, escape
# them as \n — lib/wixWebhookVerification.ts unescapes that automatically.
WIX_WEBHOOK_PUBLIC_KEY=

# Phase D — the Wix Pricing Plans Plan id for the $19.97 one-time
# Professional Mock Interview purchase, and ONLY that plan. The webhook
# refuses (fails closed) to grant any credit until this is set, and ignores
# every "Order Purchased" event for any OTHER plan id — including the
# existing $297/mo subscription plan, which must never trigger a credit.
# Find it in Wix Dashboard → Pricing Plans → the plan's settings/URL.
WIX_MOCK_INTERVIEW_PLAN_ID=

# Phase D — optional, for authoritative server-side payment re-verification
# (lib/interviewCreditGrant.ts's verifyOrderPaidWithWixApi). Without these,
# the webhook falls back to trusting the webhook payload's own
# lastPaymentStatus field, which is still checked (never skipped) but isn't
# independently confirmed against Wix's API. Get an API key from Wix
# Developers Center → your site → Settings → API Keys (needs the "Read
# Orders" permission scope), and the site id from the same dashboard's URL
# or Settings → general info.
WIX_API_KEY=
WIX_SITE_ID=

# Phase E — Fish Audio voice for the Professional Mock Interview.
# FISH_API_KEY already exists above for lesson narration — reused here
# (same Fish Audio account). The voice/model id is independently
# configurable per spec requirement 8: set this to use a DIFFERENT voice
# for the interview than narration uses; leave it blank to reuse the
# existing FISH_REFERENCE_ID (your existing custom voice) by default —
# either way, no new voice is ever created or cloned by this code.
MOCK_INTERVIEW_FISH_VOICE_ID=

# Phase E — off by default. Sending ANY audio to Fish Audio costs money;
# nothing in netlify/functions/mock-interview-voice-*.ts calls Fish Audio
# for real until this is explicitly set to "true" (spec requirement 9 — no
# paid voice API calls without your approval). Text mode works fully
# without this ever being set.
MOCK_INTERVIEW_ENABLE_LIVE_VOICE=

# Phase F — hands-free, continuous voice via Fish Audio Agents (replaces
# the push-to-talk record-button flow with natural turn-taking and
# interruption, using the SAME voice as MOCK_INTERVIEW_FISH_VOICE_ID/
# FISH_REFERENCE_ID above). Off by default — nothing in
# netlify/functions/mock-interview-voice-agent-*.ts or
# mock-interview-agent-llm.ts calls Fish Audio Agents for real until this is
# explicitly set to "true". Billed at $0.06/min by Fish Audio; push-to-talk
# and text mode both keep working regardless of this flag.
MOCK_INTERVIEW_ENABLE_LIVE_VOICE_AGENTS=

# Phase F — the id of a Fish Audio Agent you've already configured and
# PUBLISHED in Fish's own console (Builder UI), per the Phase F report's
# one-time setup steps: voice.voice_id set to your existing custom voice,
# the Custom LLM pointed at this site's
# https://<your-site>/api/mock-interview-agent-llm/chat/completions with
# its api_key set to the SAME value as FISH_AGENT_LLM_SHARED_SECRET below,
# and conversation.interruptible = true. Session creation only ever sends
# {agent_id} — all the actual voice/LLM/turn-taking config lives on the
# Agent itself, not in this codebase.
FISH_AGENT_ID=

# Phase F — the ONE shared secret Fish Audio's servers send back as
# `Authorization: Bearer <this value>` on every Custom LLM call (confirmed:
# this is how Fish authenticates itself to your endpoint — it is NOT a
# per-session secret). Set the exact same value as the Agent's
# llm.custom.api_key in Fish's console. Generate with `openssl rand -hex 32`.
FISH_AGENT_LLM_SHARED_SECRET=

# Phase F safeguards — optional, sensible defaults apply if unset. Caps how
# many hands-free Agents sessions ($0.06/min each) may be live at once
# across all students (default 3), and a hard per-session duration ceiling
# in seconds independent of the interview's own 54-minute schedule (default
# 3600) — belt-and-suspenders against a stuck session running up cost. The
# duration ceiling is configured on the Agent itself in Fish's console
# (conversation.max_duration_seconds), not sent per-session by this code.
MOCK_INTERVIEW_MAX_CONCURRENT_VOICE_AGENTS=

# Phase D — set automatically by Netlify in a real deploy (NODE_ENV=production).
# Several auth paths key off this to hard-disable dev-only shortcuts
# (devStudentEmail, mintDevCredit, minting a credit from nothing) — do NOT
# set this locally, Next/Netlify manage it themselves per environment.
# NODE_ENV=production
