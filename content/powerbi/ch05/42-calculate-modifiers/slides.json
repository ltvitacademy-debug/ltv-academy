  {
    "type": "code",
    "eyebrow": "KEEPFILTERS — combine, don't overwrite",
    "code": "CALCULATE(\n  [Sales],\n  KEEPFILTERS('Geography'[State]=\"WA\" || 'Geography'[State]=\"OR\")\n)",
    "caption": "The new filter intersects with what's already active."
  },
  {
    "type": "code",
    "eyebrow": "USERELATIONSHIP — reach an inactive one",
    "code": "CALCULATE(\n  SUM(Sales[SalesAmount]),\n  USERELATIONSHIP(Sales[ShipDateKey], 'Date'[DateKey])\n)",
