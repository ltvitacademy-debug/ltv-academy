  {
    "type": "code",
    "eyebrow": "Defining a tool",
    "code": "{\n  \"name\": \"get_weather\",\n  \"description\": \"Get the current weather for a location.\",\n  \"input_schema\": {\n    \"type\": \"object\",\n    \"properties\": {\"location\": {\"type\": \"string\"}},\n    \"required\": [\"location\"]\n  }}",
    "caption": "input_schema reuses the real JSON Schema syntax from Chapter 2."
  },
  {
    "type": "code",
    "eyebrow": "Claude's reply · a tool_use block",
    "code": "{\n  \"type\": \"tool_use\",\n  \"id\": \"toolu_01A09q90qw90lq917835lq9\",\n  \"name\": \"get_weather\",\n  \"input\": {\"location\": \"San Francisco, CA\"}\n}",
    "caption": "Claude never runs the function — your code reads this and does the lookup."
  },
  {
    "type": "code",
    "eyebrow": "Sending the answer back · tool_result",
    "code": "{\n  \"role\": \"user\",\n  \"content\": [{\n    \"type\": \"tool_result\",\n    \"tool_use_id\": \"toolu_01A09q90qw90lq917835lq9\",\n    \"content\": \"15 degrees Celsius, partly cloudy\"\n  }]\n}",
    "caption": "tool_use_id links the result back to the original tool_use call."
  },
  {
    "type": "steps",
    "eyebrow": "The complete round trip",
    "titlePlain": "Four steps, ",
