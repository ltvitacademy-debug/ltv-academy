  {
    "type": "code",
    "eyebrow": "$lookup: MongoDB's join",
    "code": "db.orders.aggregate([\n  { $lookup: {\n      from: \"customers\",\n      localField: \"customerId\",\n      foreignField: \"_id\",\n      as: \"customerInfo\"\n  } }\n])",
    "caption": "A left outer join — customerInfo comes back as an array, even for one match."
  },
  {
    "type": "code",
    "eyebrow": "$group: MongoDB's GROUP BY",
    "code": "db.orders.aggregate([\n  { $group: {\n      _id: \"$status\",\n      totalRevenue: { $sum: \"$total\" },\n      orderCount: { $count: {} }\n  } }\n])",
    "caption": "_id is the grouping key; $sum/$avg/$count/$min/$max are the accumulators."
  },
  {
    "type": "code",
    "eyebrow": "$facet: parallel pipelines, one pass",
    "code": "db.orders.aggregate([\n  { $facet: {\n      byStatus: [\n        { $group: { _id: \"$status\", count: { $count: {} } } }\n      ],\n      topOrders: [\n        { $sort: { total: -1 } }, { $limit: 5 }\n      ]\n  } }\n])",
    "caption": "Two different summaries from a single pass over the same input."
  },
