  {
    "type": "code",
    "eyebrow": "A real loop, in Bash",
    "code": "for rg in $(az group list --query \"[].name\" --output tsv); do\n  echo \"Resource group: $rg\"\n  az resource list --resource-group \"$rg\" --output tsv\ndone",
    "caption": "--output tsv gives plain rows the for loop can iterate over cleanly."
  },
  {
    "type": "code",
    "eyebrow": "The same loop, in PowerShell",
    "code": "foreach ($rg in (Get-AzResourceGroup)) {\n  Write-Output \"Resource group: $($rg.ResourceGroupName)\"\n  Get-AzResource -ResourceGroupName $rg.ResourceGroupName\n}",
    "caption": "Same job: list every group, then every resource inside each one."
