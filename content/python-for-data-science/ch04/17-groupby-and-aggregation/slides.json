  },
  {
    "type": "code",
    "eyebrow": "size vs count, with a missing value",
    "code": "g = orders.groupby(\"status\")\n\ng[\"amount\"].sum()   # pending: 0.00\ng[\"amount\"].mean()  # pending: NaN\ng.size()            # pending: 1\ng[\"amount\"].count() # pending: 0",
    "caption": "size counts rows; count counts non-missing."
