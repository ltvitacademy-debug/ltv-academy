  {
    "type": "code",
    "eyebrow": "Named aggregation",
    "code": "orders.groupby(\"customer_id\").agg(\n    n_orders=(\"order_id\", \"count\"),\n    total=(\"amount\", \"sum\"),\n    avg=(\"amount\", \"mean\"),\n    last_order=(\"order_date\", \"max\"))",
    "caption": "One row per customer, readable column names."
