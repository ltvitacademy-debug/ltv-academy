  {
    "type": "code",
    "eyebrow": "The basic pattern",
    "code": "g = orders.groupby(\"status\")\ng[\"amount\"].sum()\n\n# cancelled     60.00\n# pending        0.00\n# returned      45.00\n# shipped      795.73",
