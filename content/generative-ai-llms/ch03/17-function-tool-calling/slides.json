  {
    "type": "code",
    "eyebrow": "Step 1 · Defining a tool",
    "code": "{\n  \"name\": \"get_weather\",\n  \"description\": \"Get current weather.\",\n  \"input_schema\": {\n    \"type\": \"object\",\n    \"properties\": { \"location\": { \"type\": \"string\" } },\n    \"required\": [\"location\"]\n  }\n}",
    "caption": "A name, a description the model uses to decide when to call it, and a JSON Schema."
  },
  {
    "type": "code",
    "eyebrow": "Step 2 · The model's tool_use block",
    "code": "{\n  \"type\": \"tool_use\",\n  \"id\": \"toolu_01A09q90qw90\",\n  \"name\": \"get_weather\",\n  \"input\": {\n    \"location\": \"San Francisco, CA\"\n  }\n}",
    "caption": "stop_reason is \"tool_use\". input is already parsed — no string to decode yourself."
  },
  {
    "type": "code",
    "eyebrow": "Step 3 · Sending the result back",
    "code": "{\n  \"role\": \"user\",\n  \"content\": [{\n    \"type\": \"tool_result\",\n    \"tool_use_id\": \"toolu_01A09q90qw90\",\n    \"content\": \"15°C, partly cloudy\"\n  }]\n}",
    "caption": "Tied to the exact tool_use_id so the model knows which call this answers."
  },
