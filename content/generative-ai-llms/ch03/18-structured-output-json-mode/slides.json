  {
    "type": "code",
    "eyebrow": "Anthropic · output_config.format",
    "code": "{\n  \"output_config\": {\n    \"format\": {\n      \"type\": \"json_schema\",\n      \"schema\": { \"type\": \"object\",\n        \"properties\": {\"name\":{\"type\":\"string\"}} }\n    }\n  }\n}",
    "caption": "Output is constrained during generation — not checked afterward, restricted token by token."
  },
  {
    "type": "code",
    "eyebrow": "The response · still a text block",
    "code": "{\n  \"content\": [\n    { \"type\": \"text\",\n      \"text\": \"{\\\"name\\\":\\\"John Smith\\\"}\" }\n  ],\n  \"stop_reason\": \"end_turn\"\n}",
    "caption": "text holds a JSON string guaranteed to validate. end_turn means it succeeded."
  },
  {
    "type": "code",
    "eyebrow": "Alternative · force a tool call",
    "code": "{\n  \"tools\": [{\n    \"name\": \"extract_contact\",\n    \"input_schema\": { \"...\": \"...\" }\n  }],\n  \"tool_choice\": {\n    \"type\": \"tool\", \"name\": \"extract_contact\"\n  }\n}",
    "caption": "Result lands in content[0].input, already parsed — no JSON string to decode."
  },
