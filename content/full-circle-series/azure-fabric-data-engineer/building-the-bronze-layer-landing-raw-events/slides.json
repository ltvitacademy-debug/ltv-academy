    "type": "code",
    "eyebrow": "Reading the stream",
    "code": "raw_kafka_stream = (\n    spark.readStream.format(\"kafka\")\n    .option(\"kafka.bootstrap.servers\", kafka_bootstrap)\n    .option(\"subscribe\", \"fernbridge.delivery-events\")\n    .load()\n)\n\nparsed_events = raw_kafka_stream.select(\n    from_json(col(\"value\").cast(\"string\"), delivery_event_schema).alias(\"event\")\n)",
