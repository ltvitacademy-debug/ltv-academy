    "type": "code",
    "eyebrow": "Adding a new column",
    "code": "trips = trips.withColumn(\n  \"fare_per_mile\",\n  col(\"fare_amount\") / col(\"trip_distance\")\n)\n\ntrips.select(\"fare_amount\", \"trip_distance\", \"fare_per_mile\").show(5)",
    "caption": "Name + expression. Immutable — returns a new DataFrame, so we reassign."
  },
  {
    "type": "code",
    "eyebrow": "Overwriting an existing column",
    "code": "# Same name as an existing column REPLACES it\ntrips = trips.withColumn(\n  \"fare_amount\",\n  col(\"fare_amount\").cast(\"decimal(10,2)\")\n)",
    "caption": "The name you pass alone decides \"add\" vs. \"replace\" — nothing else marks it."
  },
  {
    "type": "code",
    "eyebrow": "Chaining calls together",
    "code": "trips = (\n  trips\n  .withColumn(\"fare_per_mile\", col(\"fare_amount\") / col(\"trip_distance\"))\n  .withColumn(\"is_long_trip\", col(\"trip_distance\") > 10)\n)",
    "caption": "Each call returns a new DataFrame — the same chaining Lesson 27's ETL script used."
