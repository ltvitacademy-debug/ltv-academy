    "eyebrow": "Azure AD Workload Identity — no secret in the pod",
    "code": "resource \"azurerm_federated_identity_credential\" \"checkout\" {\n  parent_id = azurerm_user_assigned_identity.checkout.id\n  audience  = [\"api://AzureADTokenExchange\"]\n  issuer    = azurerm_kubernetes_cluster.this.oidc_issuer_url\n  subject   =\n    \"system:serviceaccount:northbridge-${var.environment}:checkout\"\n}",
    "caption": "The checkout service account trades its own token for an Azure AD token — nothing stored"
  },
