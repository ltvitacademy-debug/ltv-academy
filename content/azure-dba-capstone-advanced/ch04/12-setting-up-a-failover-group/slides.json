  {
    "type": "code",
    "eyebrow": "Creating the group",
    "code": "New-AzSqlDatabaseFailoverGroup `\n  -ResourceGroupName \"OverlookRG\" `\n  -ServerName \"overlook-sql-prod\" `\n  -FailoverGroupName \"overlook-fg\" `\n  -PartnerServerName \"overlook-sql-prod-west\" `\n  -FailoverPolicy Automatic `\n  -GracePeriodWithDataLossHours 1",
    "caption": "Automatic failover, with a 1-hour grace period against false alarms."
  },
  {
    "type": "code",
    "eyebrow": "Adding the database",
    "code": "Add-AzSqlDatabaseToFailoverGroup `\n  -ResourceGroupName \"OverlookRG\" `\n  -ServerName \"overlook-sql-prod\" `\n  -FailoverGroupName \"overlook-fg\" `\n  -Database (Get-AzSqlDatabase -ResourceGroupName \"OverlookRG\" `\n    -ServerName \"overlook-sql-prod\" -DatabaseName \"OverlookDB\")",
    "caption": "OverlookDB now protected by the group — the app connects to one stable name."
  },
